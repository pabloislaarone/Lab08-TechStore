PORT=3000
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/techstore_db

# Secretos: generar con  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
MFA_ENC_KEY=
BCRYPT_SALT_ROUNDS=10

# Bloqueo por intentos fallidos de login
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Password de los usuarios de prueba (admin@, gerente@, empleado@, auditor@techstore.com)
SEED_PASSWORD="TechStore#2026"

# Login con Google  ->  https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login con GitHub  ->  https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
